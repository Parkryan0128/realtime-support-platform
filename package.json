{
  "name": "realtime-support-platform",
  "version": "0.1.0",
  "description": "Customer support with workspace isolation and real-time messaging",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "build": "tsc && vite build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parkryan0128/realtime-support-platform.git"
  },
  "author": "Ryan Park",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Parkryan0128/realtime-support-platform/issues"
  },
  "homepage": "https://github.com/Parkryan0128/realtime-support-platform#readme",
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "cookie": "2.0.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.2.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
